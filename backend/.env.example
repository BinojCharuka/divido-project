# Local development settings for the backend. Copy to backend/.env.local (git-ignored),
# then load it before starting:  set -a && . ./.env.local && set +a && ./mvnw spring-boot:run
#
# Point DB_URL at the local Docker database from compose.yaml, never at production:
# the backend runs Flyway migrations on startup.
export DB_URL="jdbc:postgresql://localhost:5435/divido"
export DB_USERNAME="divido"
export DB_PASSWORD="change-me-local-only"   # same value as DIVIDO_LOCAL_DB_PASSWORD in ../.env
export SERVER_PORT="8080"

# Local HTTP only. Keep true wherever the API is served over HTTPS.
export SESSION_COOKIE_SECURE="false"
export DIVIDO_CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Password reset email (DEC-045): Mailpit from compose.yaml catches it at http://localhost:8025
export DIVIDO_MAIL_ENABLED="true"
export SPRING_MAIL_HOST="localhost"
export SPRING_MAIL_PORT="1025"
export DIVIDO_MAIL_FROM="Divido <no-reply@divido.local>"
# Where the reset link in the email points (the frontend).
export DIVIDO_APP_PUBLIC_URL="http://localhost:3000"

# AI Smart Receipt Scanner (Gemini API)
# export GEMINI_API_KEY="your-gemini-api-key"
# export GEMINI_MODEL="gemini-2.5-flash"
